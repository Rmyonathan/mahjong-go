generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum MembershipTier {
  FREE
  PRO
}

enum MeetBoardType {
  BEGINNER
  ADVANCED
  MCR
  GUIDED
}

/// Table hitungan — Chicken (0 Faan OK) vs Jade HK Modified (min 1 Faan)
enum ScoringRuleset {
  CHICKEN
  JADE_HK
}

enum MeetStatus {
  OPEN
  FULL
  COMPLETED
  /// Removed from schedule UI only — meet + bookings + sessions stay in DB
  CANCELLED
}

enum MeetVisibility {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  /// Waiting for table host / club owner to accept
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PaymentMethod {
  QRIS
  VENUE
}

enum BoardTier {
  beginner
  advanced
  mcr
}

enum FormResult {
  W
  L
  D
}

enum SessionStatus {
  LIVE
  FINISHED
}

enum SeatWind {
  EAST
  SOUTH
  WEST
  NORTH
}

enum HandWinMethod {
  SELF_DRAW
  DISCARD
  DRAW
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           UserRole       @default(MEMBER)
  membershipTier MembershipTier @default(FREE)
  /// When set, PRO access ends after this instant (manual QRIS / admin grant).
  proExpiresAt   DateTime?
  playerId       String?        @unique
  player         Player?        @relation(fields: [playerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookings            Booking[]
  hostedMeets         Meet[]          @relation("MeetHost")
  captainedMeets      Meet[]          @relation("MeetCaptain")
  captainedSessions   GameSession[]   @relation("SessionCaptain")
  sessionSeats        SessionSeat[]
  puzzleVotes         PuzzleVote[]
  coachingBookings    CoachingBooking[]
  bountyClaims        BountyClaim[]
  createdTournaments  Tournament[]      @relation("TournamentCreator")
  tournamentEntries   TournamentEntry[]
  panitiaTournaments  Tournament[]      @relation("TournamentPanitia")
  wasitTournaments    Tournament[]      @relation("TournamentWasit")
  tournamentStaff     TournamentStaff[]
  sentSeatInvites     SessionSeatInvite[] @relation("SeatInviteSender")
  receivedSeatInvites SessionSeatInvite[] @relation("SeatInviteRecipient")
  handClinicPosts     HandClinicSubmission[]
  mentorApplication   MentorApplication?
  notifications       PlayerNotification[]
}

model Player {
  id                String   @id
  name              String
  nickname          String
  initials          String
  city              String
  district          String
  house             String
  experienceLevelId String
  memberSince       DateTime
  /// Club experience points — updated when a LIVE session is finished
  experienceXp      Int      @default(0)
  /// Skill rating (ELO) — updated when a LIVE session is finished
  skillRating       Int      @default(1500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User?
  standings    BoardStanding[]
  eloSnapshots PlayerEloSnapshot[]
}

model PlayerEloSnapshot {
  id           String   @id @default(cuid())
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessionId    String
  sessionTitle String
  ratingBefore Int
  ratingAfter  Int
  delta        Int
  createdAt    DateTime @default(now())

  @@unique([playerId, sessionId])
  @@index([playerId, createdAt])
}

model HandClinicSubmission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String
  sessionTitle  String
  handNumber    Int
  notes         String
  tileIdsJson   Json
  winningTileId String   @default("")
  pointsLost    Int      @default(0)
  coachNote     String?
  coachName     String?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model MentorApplication {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String
  status       String   @default("PENDING")
  reviewedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

model PlayerNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

model Season {
  id                  String   @id
  label               String
  rangeLabel          String
  sessionsPlayed      Int
  gamesPlayed         Int
  hoursAtTable        Float
  biggestHandPts      Int
  biggestHandCombo    String
  biggestHandPlayerId String
  topComboName        String
  topComboCount       Int
  hotStreakPlayerId   String
  hotStreak           Int
  selfDrawWins        Int
  discardWins         Int
  isActive            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  standings BoardStanding[]
}

model BoardStanding {
  id          String       @id @default(cuid())
  seasonId    String
  season      Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank        Int
  board       BoardTier
  points      Int
  wins        Int
  games       Int
  winRate     Float
  ptsPerWin   Int
  bonus       Int
  pen         Int
  biggestHand Int
  form        FormResult[]
  streak      Int
  selfDraw    Int
  discardWins Int

  @@unique([seasonId, playerId])
  @@index([seasonId, board, rank])
}

model GameSession {
  id            String         @id @default(cuid())
  title         String
  boardType     MeetBoardType
  /// Chicken Hand vs Jade HK Modified — same engine as /scan
  scoringRuleset ScoringRuleset @default(JADE_HK)
  status        SessionStatus  @default(LIVE)
  meetId            String?
  meet              Meet?             @relation(fields: [meetId], references: [id], onDelete: SetNull)
  /// When set, hands also sync to tournament standings (wasit / panitia live view).
  tournamentTableId String?           @unique
  tournamentTable   TournamentTable?    @relation("TournamentTableLiveSession", fields: [tournamentTableId], references: [id], onDelete: SetNull)
  captainUserId     String
  captain       User           @relation("SessionCaptain", fields: [captainUserId], references: [id])
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seats       SessionSeat[]
  hands       HandRecord[]
  seatInvites SessionSeatInvite[]

  @@index([status, startedAt])
  @@index([meetId])
}

model SessionSeat {
  id                String           @id @default(cuid())
  sessionId         String
  session           GameSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  tournamentEntryId String?
  guestName         String?
  wind              SeatWind
  seatOrder         Int
  netPoints    Int         @default(0)
  wins         Int         @default(0)
  selfDraws    Int         @default(0)
  dealtInCount Int         @default(0)

  wonHands   HandRecord[] @relation("HandWinnerSeat")
  dealtHands HandRecord[] @relation("HandDealtInSeat")
  invite     SessionSeatInvite?

  @@unique([sessionId, wind])
  @@unique([sessionId, seatOrder])
  @@index([userId])
}

model SessionSeatInvite {
  id            String      @id @default(cuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seatId        String      @unique
  seat          SessionSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  inviterUserId String
  inviter       User        @relation("SeatInviteSender", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeUserId String
  invitee       User        @relation("SeatInviteRecipient", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([sessionId, inviteeUserId])
  @@index([inviteeUserId, status])
}

model HandRecord {
  id            String        @id @default(cuid())
  sessionId     String
  session       GameSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  handNumber    Int
  winnerSeatId  String?
  winnerSeat    SessionSeat?  @relation("HandWinnerSeat", fields: [winnerSeatId], references: [id], onDelete: SetNull)
  dealtInSeatId String?
  dealtInSeat   SessionSeat?  @relation("HandDealtInSeat", fields: [dealtInSeatId], references: [id], onDelete: SetNull)
  winMethod     HandWinMethod
  points        Int           @default(0)
  combosJson    Json
  tilesJson     Json
  deltasJson    Json
  createdAt     DateTime      @default(now())

  @@unique([sessionId, handNumber])
  @@index([sessionId])
}

model Meet {
  id                String        @id @default(cuid())
  title             String
  dateLabel         String
  startTime         String
  endTime           String
  startsAt          DateTime
  endsAt            DateTime
  location          String
  boardType         MeetBoardType
  /// Hitungan for live tables launched from this meet
  scoringRuleset    ScoringRuleset @default(JADE_HK)
  maxSeats          Int
  tables            Int           @default(1)
  feeIdr            Int
  proEarlyBirdUntil DateTime?
  proOnly           Boolean       @default(false)
  status            MeetStatus    @default(OPEN)
  visibility        MeetVisibility @default(PUBLIC)
  /// Short code for private tables (e.g. JADE-AB12). Null on public meets.
  inviteCode        String?       @unique
  hostId            String?
  host              User?         @relation("MeetHost", fields: [hostId], references: [id])
  /// Who may run camera scans at this table (club tables: host picks captain)
  captainId         String?
  captain           User?         @relation("MeetCaptain", fields: [captainId], references: [id])
  /// null = unlimited scans (club / Pro host). Free player tables default to 3.
  scanLimit         Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings Booking[]
  sessions GameSession[]

  @@index([startsAt, status])
  @@index([inviteCode])
}

model Booking {
  id            String         @id @default(cuid())
  meetId        String
  meet          Meet           @relation(fields: [meetId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        BookingStatus  @default(CONFIRMED)
  paymentMethod PaymentMethod?
  seatNumber    Int?
  checkInCode   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([meetId, userId])
  @@index([meetId, status])
}

/// Daily WWYD vote — one discard pick per user per puzzle day.
model PuzzleVote {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId       String
  discardTileId  String
  createdAt      DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([puzzleId])
}

enum CoachingBookingStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

/// 1-on-1 hand audit / guided table with club coach (80/20 split offline).
model CoachingBooking {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  preferredAt DateTime?
  notes       String                 @default("")
  status      CoachingBookingStatus  @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, status])
}

/// Weekly bounty XP claim (idempotent per user + bounty key).
model BountyClaim {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bountyId   String
  weekKey    String
  xpAwarded  Int
  createdAt  DateTime @default(now())

  @@unique([userId, bountyId])
  @@index([userId, weekKey])
}

/// Active weekly quest set (default or AI-picked from verifiable catalog).
model WeeklyBountyWeek {
  id          String   @id @default(cuid())
  weekKey     String   @unique
  /// JSON array of WeeklyBounty { key, title, blurb, xp, howTo }
  questsJson  Json
  source      String   @default("default")
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum TournamentFormat {
  POINTS_RACE
  KNOCKOUT
  HYBRID_KO
}

enum TournamentStatus {
  REGISTRATION
  LIVE
  COMPLETED
}

enum TournamentEntryStatus {
  REGISTERED
  ACTIVE
  ELIMINATED
  REVIVED
  CHAMPION
}

enum TournamentTableStatus {
  WAITING
  LIVE
  FINISHED
}

enum TournamentStaffRole {
  PANITIA
  WASIT
}

/// Jade house tournament (admin-run; Zung Jung / club formats).
model Tournament {
  id                   String           @id @default(cuid())
  title                String
  subtitle             String           @default("")
  format               TournamentFormat @default(POINTS_RACE)
  status               TournamentStatus @default(REGISTRATION)
  entryFeeIdr          Int              @default(0)
  prizePoolText        String           @default("")
  maxPlayers           Int              @default(16)
  revivalEnabled       Boolean          @default(true)
  revivalFeeIdr        Int              @default(0)
  maxRevivalsPerPlayer Int              @default(1)
  /// EDIT HERE — KO: how many players advance per table (1 or 2) when closing a round.
  koAdvancePerTable    Int              @default(1)
  currentRound         Int              @default(1)
  rulesPdfUrl          String?
  rulesPdfName         String?
  /// Panitia (committee) — visible on hub; may co-manage with admin/creator.
  panitiaUserId        String?
  panitiaUser          User?            @relation("TournamentPanitia", fields: [panitiaUserId], references: [id], onDelete: SetNull)
  /// Wasit (referee) — may scan / log winning hands at live tables.
  wasitUserId          String?
  wasitUser            User?            @relation("TournamentWasit", fields: [wasitUserId], references: [id], onDelete: SetNull)
  createdById          String
  createdBy            User             @relation("TournamentCreator", fields: [createdById], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  entries TournamentEntry[]
  tables  TournamentTable[]
  hands   TournamentHand[]
  staff   TournamentStaff[]

  @@index([status, createdAt])
}

model TournamentStaff {
  id           String              @id @default(cuid())
  tournamentId String
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         TournamentStaffRole
  createdAt    DateTime            @default(now())

  @@unique([tournamentId, userId, role])
  @@index([tournamentId, role])
}

model TournamentEntry {
  id               String                @id @default(cuid())
  tournamentId     String
  tournament       Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  playerName       String
  status           TournamentEntryStatus @default(REGISTERED)
  score            Int                   @default(0)
  revivalsUsed     Int                   @default(0)
  eliminatedRound  Int?
  /// 1 = champion, 2 = runner-up, 3 = third … set when the final table closes.
  finishPlace      Int?
  createdAt        DateTime              @default(now())

  wonHands   TournamentHand[] @relation("TournamentHandWinner")
  dealtHands TournamentHand[] @relation("TournamentHandDealtIn")
  seat1Of    TournamentTable[] @relation("TableSeat1")
  seat2Of    TournamentTable[] @relation("TableSeat2")
  seat3Of    TournamentTable[] @relation("TableSeat3")
  seat4Of    TournamentTable[] @relation("TableSeat4")

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
}

model TournamentTable {
  id               String                @id @default(cuid())
  tournamentId     String
  tournament       Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundNumber      Int
  tableNumber      Int
  isKnockoutMatch  Boolean               @default(false)
  status           TournamentTableStatus @default(WAITING)
  seat1EntryId     String?
  seat1Entry       TournamentEntry?      @relation("TableSeat1", fields: [seat1EntryId], references: [id], onDelete: SetNull)
  seat2EntryId     String?
  seat2Entry       TournamentEntry?      @relation("TableSeat2", fields: [seat2EntryId], references: [id], onDelete: SetNull)
  seat3EntryId     String?
  seat3Entry       TournamentEntry?      @relation("TableSeat3", fields: [seat3EntryId], references: [id], onDelete: SetNull)
  seat4EntryId     String?
  seat4Entry       TournamentEntry?      @relation("TableSeat4", fields: [seat4EntryId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  /// JSON array of finished `GameSession` ids for this table (live logs / replay).
  sessionLogIds    String                @default("[]")

  hands       TournamentHand[]
  liveSession GameSession? @relation("TournamentTableLiveSession")

  @@unique([tournamentId, roundNumber, tableNumber])
  @@index([tournamentId, status])
}

model TournamentHand {
  id              String        @id @default(cuid())
  tournamentId    String
  tournament      Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tableId         String
  table           TournamentTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  roundNumber     Int
  handNumber      Int
  winnerEntryId   String?
  winnerEntry     TournamentEntry? @relation("TournamentHandWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  dealtInEntryId  String?
  dealtInEntry    TournamentEntry? @relation("TournamentHandDealtIn", fields: [dealtInEntryId], references: [id], onDelete: SetNull)
  winMethod       HandWinMethod @default(DISCARD)
  points          Int           @default(0)
  combosSummary   String?
  deltasJson      String        @default("[]")
  createdAt       DateTime      @default(now())

  @@unique([tableId, handNumber])
  @@index([tournamentId, roundNumber])
}
