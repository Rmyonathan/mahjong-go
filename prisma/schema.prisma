generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum MembershipTier {
  FREE
  PRO
}

enum MeetBoardType {
  BEGINNER
  ADVANCED
  MCR
  GUIDED
}

enum MeetStatus {
  OPEN
  FULL
  COMPLETED
}

enum MeetVisibility {
  PUBLIC
  PRIVATE
}

enum BookingStatus {
  /// Waiting for table host / club owner to accept
  PENDING
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PaymentMethod {
  QRIS
  VENUE
}

enum BoardTier {
  beginner
  advanced
  mcr
}

enum FormResult {
  W
  L
  D
}

enum SessionStatus {
  LIVE
  FINISHED
}

enum SeatWind {
  EAST
  SOUTH
  WEST
  NORTH
}

enum HandWinMethod {
  SELF_DRAW
  DISCARD
  DRAW
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           UserRole       @default(MEMBER)
  membershipTier MembershipTier @default(FREE)
  /// When set, PRO access ends after this instant (manual QRIS / admin grant).
  proExpiresAt   DateTime?
  playerId       String?        @unique
  player         Player?        @relation(fields: [playerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookings            Booking[]
  hostedMeets         Meet[]          @relation("MeetHost")
  captainedMeets      Meet[]          @relation("MeetCaptain")
  captainedSessions   GameSession[]   @relation("SessionCaptain")
  sessionSeats        SessionSeat[]
  puzzleVotes         PuzzleVote[]
  coachingBookings    CoachingBooking[]
  bountyClaims        BountyClaim[]
}

model Player {
  id                String   @id
  name              String
  nickname          String
  initials          String
  city              String
  district          String
  house             String
  experienceLevelId String
  memberSince       DateTime
  /// Club experience points — updated when a LIVE session is finished
  experienceXp      Int      @default(0)
  /// Skill rating (ELO) — updated when a LIVE session is finished
  skillRating       Int      @default(1500)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User?
  standings  BoardStanding[]
}

model Season {
  id                  String   @id
  label               String
  rangeLabel          String
  sessionsPlayed      Int
  gamesPlayed         Int
  hoursAtTable        Float
  biggestHandPts      Int
  biggestHandCombo    String
  biggestHandPlayerId String
  topComboName        String
  topComboCount       Int
  hotStreakPlayerId   String
  hotStreak           Int
  selfDrawWins        Int
  discardWins         Int
  isActive            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  standings BoardStanding[]
}

model BoardStanding {
  id          String       @id @default(cuid())
  seasonId    String
  season      Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank        Int
  board       BoardTier
  points      Int
  wins        Int
  games       Int
  winRate     Float
  ptsPerWin   Int
  bonus       Int
  pen         Int
  biggestHand Int
  form        FormResult[]
  streak      Int
  selfDraw    Int
  discardWins Int

  @@unique([seasonId, playerId])
  @@index([seasonId, board, rank])
}

model GameSession {
  id            String         @id @default(cuid())
  title         String
  boardType     MeetBoardType
  status        SessionStatus  @default(LIVE)
  meetId        String?
  meet          Meet?          @relation(fields: [meetId], references: [id], onDelete: SetNull)
  captainUserId String
  captain       User           @relation("SessionCaptain", fields: [captainUserId], references: [id])
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  seats SessionSeat[]
  hands HandRecord[]

  @@index([status, startedAt])
  @@index([meetId])
}

model SessionSeat {
  id           String      @id @default(cuid())
  sessionId    String
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName    String?
  wind         SeatWind
  seatOrder    Int
  netPoints    Int         @default(0)
  wins         Int         @default(0)
  selfDraws    Int         @default(0)
  dealtInCount Int         @default(0)

  wonHands   HandRecord[] @relation("HandWinnerSeat")
  dealtHands HandRecord[] @relation("HandDealtInSeat")

  @@unique([sessionId, wind])
  @@unique([sessionId, seatOrder])
  @@index([userId])
}

model HandRecord {
  id            String        @id @default(cuid())
  sessionId     String
  session       GameSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  handNumber    Int
  winnerSeatId  String?
  winnerSeat    SessionSeat?  @relation("HandWinnerSeat", fields: [winnerSeatId], references: [id], onDelete: SetNull)
  dealtInSeatId String?
  dealtInSeat   SessionSeat?  @relation("HandDealtInSeat", fields: [dealtInSeatId], references: [id], onDelete: SetNull)
  winMethod     HandWinMethod
  points        Int           @default(0)
  combosJson    Json
  tilesJson     Json
  deltasJson    Json
  createdAt     DateTime      @default(now())

  @@unique([sessionId, handNumber])
  @@index([sessionId])
}

model Meet {
  id                String        @id @default(cuid())
  title             String
  dateLabel         String
  startTime         String
  endTime           String
  startsAt          DateTime
  endsAt            DateTime
  location          String
  boardType         MeetBoardType
  maxSeats          Int
  tables            Int           @default(1)
  feeIdr            Int
  proEarlyBirdUntil DateTime?
  proOnly           Boolean       @default(false)
  status            MeetStatus    @default(OPEN)
  visibility        MeetVisibility @default(PUBLIC)
  /// Short code for private tables (e.g. JADE-AB12). Null on public meets.
  inviteCode        String?       @unique
  hostId            String?
  host              User?         @relation("MeetHost", fields: [hostId], references: [id])
  /// Who may run camera scans at this table (club tables: host picks captain)
  captainId         String?
  captain           User?         @relation("MeetCaptain", fields: [captainId], references: [id])
  /// null = unlimited scans (club / Pro host). Free player tables default to 3.
  scanLimit         Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings Booking[]
  sessions GameSession[]

  @@index([startsAt, status])
  @@index([inviteCode])
}

model Booking {
  id            String         @id @default(cuid())
  meetId        String
  meet          Meet           @relation(fields: [meetId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        BookingStatus  @default(CONFIRMED)
  paymentMethod PaymentMethod?
  seatNumber    Int?
  checkInCode   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([meetId, userId])
  @@index([meetId, status])
}

/// Daily WWYD vote — one discard pick per user per puzzle day.
model PuzzleVote {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzleId       String
  discardTileId  String
  createdAt      DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([puzzleId])
}

enum CoachingBookingStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

/// 1-on-1 hand audit / guided table with club coach (80/20 split offline).
model CoachingBooking {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  preferredAt DateTime?
  notes       String                 @default("")
  status      CoachingBookingStatus  @default(PENDING)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, status])
}

/// Weekly bounty XP claim (idempotent per user + bounty key).
model BountyClaim {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bountyId   String
  weekKey    String
  xpAwarded  Int
  createdAt  DateTime @default(now())

  @@unique([userId, bountyId])
  @@index([userId, weekKey])
}
